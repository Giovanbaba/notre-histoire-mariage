{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notre-histoire-mariage",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/puzzle", "/puzzle/*"]
  },
  "routes": [
    { "pattern": "laura-giova.be", "custom_domain": true },
    { "pattern": "photos.laura-giova.be", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "WEDDING_BUCKET", "bucket_name": "laura-giovanni-mariage" }
  ]
}
