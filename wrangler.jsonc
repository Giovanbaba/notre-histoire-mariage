{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notre-histoire-mariage",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/accueil/*",
      "/programme/*",
      "/menu/*",
      "/jeux/*",
      "/souvenirs/*",
      "/puzzle",
      "/puzzle/*",
      "/appareil/*",
      "/photos-mariage/*",
      "/videos-mariage/*",
      "/defis/*",
      "/classement/*",
      "/recompenses/*",
      "/partage/*",
      "/hit-kiss/*",
      "/animateur/*",
      "/admin-defis/*",
      "/mur/*",
      "/dj/*",
      "/roue/*"
    ]
  },
  "routes": [
    {
      "pattern": "laura-giova.be",
      "custom_domain": true
    },
    {
      "pattern": "www.laura-giova.be/*",
      "zone_name": "laura-giova.be"
    },
    {
      "pattern": "photos.laura-giova.be",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "WEDDING_BUCKET",
      "bucket_name": "laura-giovanni-mariage"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WEDDING_STATE", "class_name": "WeddingState" },
      { "name": "HIT_KISS", "class_name": "HitKissRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WeddingState", "HitKissRoom"] }
  ],
  "vars": {
    "AI_VISION_MODEL": "gpt-5-mini",
    "AI_TTS_MODEL": "gpt-4o-mini-tts",
    "AI_VOICE": "onyx"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
